{
  "name": "capacitor-apple-pencil",
  "version": "1.0.0",
  "description": "Capacitor plugin for advanced Apple Pencil integration using PencilKit",
  "main": "dist/plugin.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "scripts": {
    "build": "npm run clean && tsc && rollup -c rollup.config.js",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/core": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/ios": "^5.0.0",
    "rimraf": "^3.0.2",
    "rollup": "^2.32.0",
    "typescript": "^4.0.5"
  },
  "peerDependencies": {
    "@capacitor/core": "^5.0.0"
  },
  "files": [
    "dist/",
    "ios/",
    "capacitor-apple-pencil.podspec"
  ],
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "apple pencil",
    "pencilkit",
    "ios"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    }
  }
