{
  "appId": "io.yarvind.bulletjournal",
  "appName": "BulletJournal",
  "webDir": "www",
  "bundledWebRuntime": false,
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#f5f5f5",
    "preferredContentMode": "mobile",
    "scheme": "bulletjournal",
    "appendUserAgent": "BulletJournal iOS App"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#f5f5f5",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
