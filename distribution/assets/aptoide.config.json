{
  "appId": "io.yarvind.bulletjournal.apt",
  "appName": "BulletJournal",
  "webDir": "www",
  "version": "1.0.0",
  "build": 1,
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#f5f5f5",
    "preferredContentMode": "mobile",
    "scheme": "bulletjournal-apt",
    "appendUserAgent": "BulletJournal iOS App (Aptoide)"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#f5f5f5",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}

